# Copy to .env.local (git-ignored; this file is named without the dot so Vercel does not pre-fill placeholders). Same names go into the Vercel project's environment.

# --- Clerk (dashboard → API keys). Free plan: Google SSO + email code, access mode Restricted. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# After the first successful sign-in, paste your user id (user_...) here so no
# other Clerk user of this instance can ever see the app.
OWNER_CLERK_USER_ID=

# --- Neon. Use the pooled connection string. ---
DATABASE_URL=postgres://...

# --- AES-256-GCM key for provider access tokens (unused until phase four, but
# generate it now so it exists before anything needs it):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Plaid (dashboard → Developers → Keys). Production is the environment the probe used. ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
# Where OAuth banks send the browser back. Must be https and listed under Developers → API
# settings → Allowed redirect URIs in the Plaid dashboard. Leave empty for sandbox on localhost.
PLAID_REDIRECT_URI=https://ledger.alistation.net/settings
